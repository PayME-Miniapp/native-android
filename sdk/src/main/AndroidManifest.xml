<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">


  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
  <uses-permission android:name="android.permission.READ_CONTACTS" />
  <uses-permission android:name="android.permission.NFC"/>
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

  <uses-feature android:name="android.hardware.camera" />
  <uses-feature android:name="android.hardware.camera.autofocus"
      android:required="false" />
  <uses-feature android:name="android.hardware.NFC" android:required="false" />
  <uses-feature android:name="android.hardware.nfc" android:required="false" />

  <!--
    SDK chỉ khai báo networkSecurityConfig: web Miniapp chạy trên http://localhost nên cần cleartext tới localhost.
    Không đặt thuộc tính <application> khác (backup, storage, RTL...) để không đè cấu hình của ứng dụng.
    Ứng dụng có networkSecurityConfig riêng: tools:replace và cho phép cleartext tới localhost (xem README).
  -->
  <application android:networkSecurityConfig="@xml/payme_miniapp_network_security_config">
    <activity android:name=".ui.MiniAppActivity" android:exported="false" android:theme="@style/AppTheme" android:screenOrientation="portrait" android:windowSoftInputMode="stateHidden" />
    <activity android:name=".ui.FaceDetectorActivity" android:exported="false" android:screenOrientation="portrait" android:theme="@style/CameraActivityTheme" android:windowSoftInputMode="stateHidden" />
    <activity android:name=".ui.FaceAuthenticationActivity" android:exported="false" android:screenOrientation="portrait" android:theme="@style/CameraActivityTheme" android:windowSoftInputMode="stateHidden" />
    <activity android:name=".ui.IdentityCardActivity" android:exported="false" android:screenOrientation="portrait" android:theme="@style/CameraActivityTheme" android:windowSoftInputMode="stateHidden" />
  </application>

</manifest>
